				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
# CapsWriter-Offline: 添加热词快捷操作
# 选中文字后触发，自动追加到 hot.txt

HOT_FILE="$HOME/Projects/capswriter-mac/CapsWriter-Offline/hot.txt"

# 从 stdin 读取选中的文字
HOTWORD=$(cat)

# 去掉首尾空白
HOTWORD=$(echo "$HOTWORD" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$HOTWORD" ]; then
    osascript -e 'display notification "没有选中文字" with title "CapsWriter"'
    exit 0
fi

# 追加到 hot.txt
echo "$HOTWORD" &gt;&gt; "$HOT_FILE"

# 弹出通知
osascript -e "display notification \"已添加：$HOTWORD\" with title \"CapsWriter 热词\""</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>0</integer>
					<key>shell</key>
					<string>/bin/bash</string>
				</dict>
